# Copy to /opt/hellolocal/beta.env on the server (mode 600). Do not commit the filled file.
# Generate new values. Do not copy /opt/hellolocal/stack.env, apps/api/.env,
# or the production DATABASE_URL. A shared production database is not a beta.
#
# The compose file builds the URL itself:
#   postgresql://hellolocal:${POSTGRES_PASSWORD}@beta-db:5432/hellolocal
# on the Docker volume hellolocal-beta-pgdata (empty, then prisma migrate deploy).
# Do not set DATABASE_URL in this file.

POSTGRES_PASSWORD=
JWT_SECRET=
BETA_SRC=/opt/hellolocal/beta
