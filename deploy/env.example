POSTGRES_PASSWORD=
JWT_SECRET_PROD=
JWT_SECRET_DEVEL=
PROD_SRC=/opt/hellolocal/prod
DEVEL_SRC=/opt/hellolocal/devel

# Outbound mail (Resend free SMTP). Leave empty to store leads without sending.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# EMAIL_FROM=HelloLocal <noreply@hellolocal.hu>

# Google reCAPTCHA v3 (free for typical traffic). Create a pair at
# https://www.google.com/recaptcha/admin — type: reCAPTCHA v3.
# Domains in Console MUST match VITE_RECAPTCHA_HOSTS (e.g. hello-local.io,
# hellolocal.hu, localhost). Script is not loaded on other hosts (avoids the
# “invalid domain for site key” owner badge on custom / unlisted domains).
# Site key → web image build; secret → API runtime.
# VITE_RECAPTCHA_SITE_KEY=
# VITE_RECAPTCHA_HOSTS=hello-local.io,hellolocal.hu,localhost
# RECAPTCHA_SECRET_KEY=

# Google Sign-In (OAuth Web client). Callback must match the public API host.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://api.hello-local.io/api/auth/google/callback

# AI content draft (optional). Prefer App Settings → encrypted Gemini/Groq/OpenRouter key.
# Compose passes these into api-prod as fallback when the boxed App Settings key is
# missing or unreadable (e.g. after JWT_SECRET_PROD / APP_SECRET rotation):
# GEMINI_API_KEY=
# CONTENT_DRAFT_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# APP_SECRET=
# Keep JWT_SECRET_PROD / APP_SECRET stable — rotating them breaks the boxed key
# until you re-save the key in App Settings or set GEMINI_API_KEY above.

# A beta nem ezt a fájlt és nem a production adatbázist használja.
# Sablon: deploy/env.beta.example → a szerveren /opt/hellolocal/beta.env
