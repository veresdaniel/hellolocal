{
  "name": "hellolocal",
  "version": "1.0.9-beta",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.cjs",
    "hooks:install": "node scripts/install-git-hooks.cjs",
    "version:bump": "node scripts/bump-version-on-commit.cjs",
    "dev:web": "pnpm -C apps/web dev",
    "dev:api": "pnpm -C apps/api start:dev",
    "local:dev": "node scripts/local-dev.cjs",
    "local:staging": "node scripts/staging.cjs",
    "local:live": "node scripts/local-live.cjs",
    "staging": "node scripts/staging.cjs",
    "staging:web": "pnpm -C apps/web staging",
    "staging:api": "pnpm -C apps/api start:staging",
    "build:shared": "pnpm -C packages/shared build",
    "build": "pnpm run build:shared && pnpm -C apps/api build && pnpm -C apps/web build",
    "start:api": "pnpm -C apps/api start",
    "start:web": "pnpm -C apps/web preview",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:critical": "vitest run --config vitest.critical.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:report": "vitest run --config vitest.report.config.ts",
    "lint": "pnpm -C apps/api lint && pnpm -C apps/web lint",
    "lint:fix": "pnpm -C apps/api lint:fix && pnpm -C apps/web lint:fix",
    "format": "pnpm -C apps/api format && pnpm -C apps/web format",
    "format:check": "pnpm -C apps/api format:check && pnpm -C apps/web format:check"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.17.1",
      "hono": "4.13.16",
      "@isaacs/brace-expansion": "5.0.1",
      "proxy-addr": "2.0.8",
      "markdown-it": "14.3.3",
      "prosemirror-view": "1.42.9",
      "bn.js": "4.12.5",
      "multer": "2.5.0",
      "body-parser@1": "1.20.9",
      "body-parser@2": "2.4.0",
      "path-to-regexp@0": "0.1.13",
      "path-to-regexp@8": "8.4.2",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7"
    }
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
