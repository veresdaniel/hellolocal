# HelloLocal API Environment Variables
# Copy this file to .env and fill in your values

# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/hellolocal"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server Configuration
NODE_ENV="development"
PORT=3002
FRONTEND_URL="http://localhost:5173"

# Facebook Open Graph cache refresh (admin "Refresh social preview" + post-SEO-save).
# App access token = FACEBOOK_APP_ID|FACEBOOK_APP_SECRET (Graph API POST /?id=&scrape=true).
# Unauthenticated scrape is not allowed. Leave unset to no-op with a clear admin toast.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# CORS Configuration
# Productionban: csak a megbízható domain-ek (vesszővel elválasztva)
# Példa: CORS_ORIGIN=https://hellolocal.com,https://www.hellolocal.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Web Push Notifications (Optional)
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:your-email@example.com"

# Email via SMTP (Resend free: smtp.resend.com, user=resend, pass=API key).
# Code reads EMAIL_FROM (not SMTP_FROM). Domain must be verified at the provider.
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=465
# SMTP_USER="resend"
# SMTP_PASS="re_xxxxxxxx"
# EMAIL_FROM="HelloLocal <noreply@hellolocal.hu>"

# Invisible reCAPTCHA v3. Leave empty locally: honeypot and timing still apply,
# and a missing secret is not treated as a passed captcha.
# RECAPTCHA_SECRET_KEY=

# Free-trial abuse (optional). Card verify only when STRIPE_SECRET_KEY is set and
# AppSetting platform.freeTrialRequireCard=true. Soft IP hash uses SIGNUP_ABUSE_SALT
# (falls back to JWT_SECRET).
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# SIGNUP_ABUSE_SALT=

