# HelloLocal API — helyi staging
# Másold ezt a fájlt ide: apps/api/.env.staging
# A másolat gitignore-olt (gyökér .gitignore: .env.* , valamint apps/api/.gitignore).
# Ne commitolj titkot, és ne másold ide a production vagy a fejlesztői .env tartalmát.
#
# Indítás a repó gyökeréből: pnpm local:staging  (alias: pnpm staging)
#   API:  http://localhost:3003
#   Web:  http://localhost:5174
# A fejlesztői szerverek változatlanok: pnpm local:dev / pnpm dev:api (3002, apps/api/.env)
# és pnpm dev:web (5173). Éles böngészés: pnpm local:live (5175 → api.hello-local.io proxy).
#
# Töltsd ki a DATABASE_URL-t, amikor a beta Postgres létezik
# (compose project: hellolocal-beta). Felhő URL-t ne találj ki.
# Ne a production adatbázist használd (Hetzner compose project hellolocal,
# api.hello-local.io), és ne másolj onnan adatot.
#
# A staging induló script ezeket a folyamatban felülírja, hogy a dev mellett elférjen:
#   PORT=3003
#   NODE_ENV=development
#   FRONTEND_URL=http://localhost:5174
#   API_URL=http://localhost:3003
#   APP_BASE_URL=http://localhost:5174
#   CORS_ORIGIN tartalmazza a http://localhost:5174 origint
#     (a http://localhost:5173 és http://localhost:3000 kikerül)
# A DATABASE_URL, a JWT és a többi titok ebből a fájlból jön.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

NODE_ENV="development"
PORT=3003
FRONTEND_URL="http://localhost:5174"
CORS_ORIGIN=http://localhost:5174
API_URL="http://localhost:3003"
APP_BASE_URL="http://localhost:5174"
GOOGLE_CALLBACK_URL="http://localhost:3003/api/auth/google/callback"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Opcionális. Ugyanazok a nevek, mint az apps/api/env.example fájlban.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:your-email@example.com"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
