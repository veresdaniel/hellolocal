{
  "name": "hellolocal-api",
  "version": "1.0.0-beta",
  "description": "HelloLocal Backend API - Multi-tenant local tourism platform",
  "main": "index.js",
  "scripts": {
    "test:visitor-ladder": "tsx --test src/visitor-ladder/visitor-ladder.test.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start:dev": "nest start --watch",
    "start:staging": "node scripts/start-staging.cjs",
    "migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:seed-sample-images": "node prisma/seed-sample-images.cjs",
    "generate": "prisma generate && bash scripts/copy-prisma-client.sh",
    "generate:ui-seed": "node scripts/generate-ui-seed-catalogs.cjs",
    "postinstall": "prisma generate && bash scripts/copy-prisma-client.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@hellolocal/shared": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/throttler": "^6.1.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.3",
    "helmet": "^8.0.0",
    "libphonenumber-js": "^1.13.17",
    "nodemailer": "^10.6.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "speakeasy": "^2.0.0",
    "stripe": "17.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/node": "^24.10.4",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
